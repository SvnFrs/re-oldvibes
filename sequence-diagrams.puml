@startuml Create Comment
title Sequence Diagram: Create Comment

actor User
participant "Frontend" as Frontend
participant "Express Router" as Router
participant "Auth Middleware" as Auth
participant "Role Middleware" as Role
participant "Validation Middleware" as Validation
participant "Comment Controller" as Controller
participant "User Model" as UserModel
participant "Vibe Model" as VibeModel
participant "Moderation Service" as Moderation
participant "Comment Model" as CommentModel
database "MongoDB" as DB

User -> Frontend: Type comment content\nClick submit
Frontend -> Router: POST /api/vibes/{vibeId}/comments\n{content, parentCommentId?}\n(credentials: include)
Router -> Auth: authenticateToken()
Auth -> Auth: Verify JWT token
Auth -> Router: Token valid, user authenticated
Router -> Role: requireUser()
Role -> Role: Check user role
Role -> Router: Role check passed
Router -> Validation: validateCommentCreation()
Validation -> Validation: Validate content (required, maxLength)
Validation -> Router: Validation passed
Router -> Controller: createComment(req, res)
Controller -> Controller: Extract vibeId, userId, commentData
Controller -> UserModel: Find user by userId
UserModel -> DB: Find User by ID
DB -> UserModel: User document
UserModel -> Controller: User object
alt User is temp banned
    Controller -> Frontend: 403 Forbidden\n{message: "Temporarily banned", reason, badBehaviorCount}
    Frontend -> User: Show ban message
else User not temp banned
    Controller -> VibeModel: getById(vibeId)
    VibeModel -> DB: Find Vibe by ID
    DB -> VibeModel: Vibe document
    VibeModel -> Controller: Vibe object
    alt Vibe not found or not approved
        Controller -> Frontend: 404 Not Found\n{message: "Vibe not available"}
        Frontend -> User: Show error message
    else Vibe found and approved
        Controller -> Moderation: moderateComment(content, vibe.itemName)
        Moderation -> Moderation: Call Gemini AI\nCheck for violations
        Moderation -> Controller: {isClean, reason?, categories?, confidence}
        alt Comment violates guidelines
            Controller -> Controller: Increment badBehaviorCount\nAdd to badBehaviorHistory
            alt badBehaviorCount >= 3
                Controller -> Controller: Set isTempBanned = true\nSet tempBanReason, tempBanAt
            end
            Controller -> UserModel: Save user with updated bad behavior
            UserModel -> DB: Update User document
            DB -> UserModel: Updated
            Controller -> Frontend: 400 Bad Request\n{message: "Comment violates guidelines",\nreason, categories, badBehaviorCount, warning}
            Frontend -> User: Show moderation warning
        else Comment is clean
            alt parentCommentId provided
                Controller -> CommentModel: getById(parentCommentId)
                CommentModel -> DB: Find Comment by ID
                DB -> CommentModel: Parent comment
                CommentModel -> Controller: Parent comment
                alt Parent comment not found
                    Controller -> Frontend: 404 Not Found\n{message: "Parent comment not found"}
                    Frontend -> User: Show error
                else Parent comment found
                    Controller -> CommentModel: create(userId, vibeId, commentData)
                    CommentModel -> DB: Save new Comment document
                    DB -> CommentModel: Saved comment
                    CommentModel -> DB: Update Vibe commentsCount (+1)
                    CommentModel -> DB: Update parent Comment repliesCount (+1)
                    DB -> CommentModel: Updated
                    CommentModel -> Controller: New comment
                    Controller -> Frontend: 201 Created\n{message, comment, moderationInfo}
                    Frontend -> User: Show comment in list
                end
            else No parent comment
                Controller -> CommentModel: create(userId, vibeId, commentData)
                CommentModel -> DB: Save new Comment document
                DB -> CommentModel: Saved comment
                CommentModel -> DB: Update Vibe commentsCount (+1)
                DB -> CommentModel: Updated
                CommentModel -> Controller: New comment
                Controller -> Frontend: 201 Created\n{message, comment, moderationInfo}
                Frontend -> User: Show comment in list
            end
        end
    end
end
@enduml

@startuml Comment Filter by Vibe
