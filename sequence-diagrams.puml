@startuml Create Staff
title Sequence Diagram: Create Staff

actor Admin
participant "Admin Frontend" as Frontend
participant "Express Router" as Router
participant "Auth Middleware" as Auth
participant "Role Middleware" as Role
participant "Admin Controller" as Controller
participant "User Model" as UserModel
database "MongoDB" as DB

Admin -> Frontend: Fill staff form\n(email, password, name, username)
Frontend -> Router: POST /api/admin/staff\n{email, password, name, username}
Router -> Auth: authenticateToken()
Auth -> Auth: Verify JWT token
Auth -> Router: Token valid, user authenticated
Router -> Role: requireAdmin()
Role -> Role: Check user role = "admin"
Role -> Router: Role check passed
Router -> Controller: addStaff(req, res)
Controller -> Controller: Validate required fields
Controller -> UserModel: getByEmail(email)
UserModel -> DB: Query User by email
DB -> UserModel: Result
UserModel -> Controller: Email exists? (No)
Controller -> UserModel: getByUsername(username)
UserModel -> DB: Query User by username
DB -> UserModel: Result
UserModel -> Controller: Username exists? (No)
Controller -> UserModel: createStaff({email, password, name, username, role: "staff"})
UserModel -> UserModel: Hash password with bcrypt
UserModel -> DB: Save new User document
DB -> UserModel: Saved user
UserModel -> Controller: Staff created
Controller -> Frontend: 201 Created\n{message, staff}
Frontend -> Admin: Show success message
@enduml

