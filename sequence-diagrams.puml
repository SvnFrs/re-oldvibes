Frontend -> Frontend: Build query params\n(vibeId, limit, offset, sortBy, search)
Frontend -> Router: GET /api/admin/vibes/{vibeId}/comments?\nlimit=20&offset=0&sortBy=newest&search=...\n(credentials: include)
Router -> Auth: authenticateToken()
Auth -> Auth: Verify JWT token
Auth -> Router: Token valid
Router -> Role: requireStaff()
