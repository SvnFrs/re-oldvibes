    CommentModel -> CommentModel: Format comment responses
    CommentModel -> Controller: {comments, total, hasMore}
    Controller -> Frontend: 200 OK\n{comments, pagination: {total, limit, offset, hasMore}}
    Frontend -> Frontend: Set comments state
    Frontend -> Admin: Display filtered comments list
end
@enduml

