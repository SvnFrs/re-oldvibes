@startuml Vibe Management (Admin)
title Class Diagram: Vibe Management for Admin

package "Admin Controllers" {
  class AdminController {
    +getAllVibesAdmin(req, res): Promise<void>
    +getVibeDetailAdmin(req, res): Promise<void>
    +getVibesWithFilters(req, res): Promise<void>
    --
    -vibeModel: VibeModel
  }
}

package "Vibe Model" {
  class VibeModel {
    +getAllVibesAdmin(filters): Promise<{data, pagination, totalCount}>
    +getVibesWithFilters(filters): Promise<PaginatedResponse<VibeResponse>>
    +getById(vibeId, userId?): Promise<VibeResponse | null>
    +formatVibeResponse(vibe, userId?): VibeResponse
    --
    -buildQuery(filters): any
    -buildSortCriteria(sortBy): any
  }
}

package "Routes" {
  class AdminRoutes {
    +GET /admin/vibes
    +GET /admin/vibes/:vibeId
    +GET /admin/vibes/filter
    --
    +authenticateToken()
    +requireStaff()
  }
}

package "Middleware" {
  class AuthMiddleware {
    +authenticateToken(req, res, next): void
    -verifyToken(token): JWTPayload
  }
  
  class RoleMiddleware {
    +requireStaff(req, res, next): Promise<void>
    +requireAdmin(req, res, next): Promise<void>
    -checkRole(user, allowedRoles): boolean
  }
}

package "Types" {
  class VibeResponse {
    +id: string
    +userId: string
    +user: UserInfo
    +itemName: string
    +description: string
    +price: number
    +status: VibeStatus
    +category: string
    +condition: string
    +location: string
    +tags: string[]
    +mediaFiles: string[]
    +likesCount: number
    +commentsCount: number
    +views: number
    +isLiked?: boolean
    +createdAt: Date
    +updatedAt: Date
  }
  
  class VibeFilters {
    +name?: string
    +category?: string
    +minPrice?: number
    +maxPrice?: number
    +condition?: string
    +status?: string
    +limit: number
    +offset: number
    +sortBy?: string
  }
  
  enum VibeStatus {
    pending
    approved
    rejected
    sold
    archived
  }
}

package "Schema" {
  class VibeSchema {
    +_id: ObjectId
    +userId: ObjectId
    +itemName: string
    +description: string
    +price: number
    +status: VibeStatus
    +category: string
    +condition: string
    +location: string
    +tags: string[]
    +mediaFiles: string[]
    +likes: ObjectId[]
    +commentsCount: number
    +views: number
    +expiresAt?: Date
    +createdAt: Date
    +updatedAt: Date
  }
}

