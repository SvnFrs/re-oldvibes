@startuml Staff Management
title Class Diagram: Staff Management

package "Admin Controllers" {
  class AdminController {
    +addStaff(req, res): Promise<void>
    +editStaff(req, res): Promise<void>
    +deleteStaff(req, res): Promise<void>
    +listStaff(req, res): Promise<void>
    --
    -userModel: UserModel
    -validateStaffData(data): boolean
  }
}

package "User Model" {
  class UserModel {
    +createStaff(staffData): Promise<IUser>
    +updateStaff(staffId, updateData): Promise<IUser | null>
    +deleteStaff(staffId): Promise<boolean>
    +listStaff(): Promise<IUser[]>
    +getByEmail(email): Promise<IUser | null>
    +getByUsername(username): Promise<IUser | null>
    --
    -hashPassword(password): Promise<string>
  }
}

package "Routes" {
  class AdminRoutes {
    +POST /admin/staff
    +PUT /admin/staff/:staffId
    +DELETE /admin/staff/:staffId
    +GET /admin/staff
    --
    +authenticateToken()
    +requireAdmin()
  }
}

package "Middleware" {
  class AuthMiddleware {
    +authenticateToken(req, res, next): void
    -verifyToken(token): JWTPayload
  }
  
  class RoleMiddleware {
    +requireAdmin(req, res, next): Promise<void>
    -checkRole(user, allowedRoles): boolean
  }
}

package "Types" {
  class StaffCreateInput {
    +email: string
    +password: string
    +name: string
    +username: string
    +role: "staff"
  }
  
  class StaffUpdateInput {
    +email?: string
    +name?: string
    +username?: string
    +bio?: string
    +profilePicture?: string
  }
  
  class StaffResponse {
    +id: string
    +email: string
    +name: string
    +username: string
    +role: "staff"
    +isActive: boolean
    +isEmailVerified: boolean
    +createdAt: Date
    +updatedAt: Date
  }
}

package "Schema" {
  class UserSchema {
    +_id: ObjectId
    +email: string
    +password: string (hashed)
    +username: string
    +name: string
    +role: UserRole
    +bio?: string
    +profilePicture?: string
    +isActive: boolean
    +isEmailVerified: boolean
    +badBehaviorCount: number
    +isTempBanned: boolean
    +createdAt: Date
    +updatedAt: Date
  }
  
  enum UserRole {
    admin
    staff
    user
  }
}

' Relationships
AdminRoutes --> AuthMiddleware : uses
AdminRoutes --> RoleMiddleware : uses
AdminRoutes --> AdminController : routes to

AdminController --> UserModel : uses

UserModel --> UserSchema : queries/updates
UserModel --> StaffCreateInput : accepts
UserModel --> StaffUpdateInput : accepts

AdminController --> StaffCreateInput : accepts
AdminController --> StaffUpdateInput : accepts
AdminController --> StaffResponse : returns

StaffCreateInput --> UserRole : uses
StaffUpdateInput --> UserRole : uses
StaffResponse --> UserRole : uses

UserSchema --> UserRole : uses

note right of AdminController
  Staff CRUD operations:
  - addStaff: Create new staff member
    (requires unique email/username)
  - editStaff: Update staff info
    (admin only)
  - deleteStaff: Soft delete staff
    (sets isActive = false)
  - listStaff: Get all active staff
end note

note right of UserModel
  Staff-specific methods:
  - createStaff: Creates staff with
    hashed password, auto-verified email
  - updateStaff: Updates staff profile
    (excludes password, role)
  - deleteStaff: Soft delete
    (isActive = false)
  - listStaff: Returns active staff only
end note

note right of AdminRoutes
  All staff routes require:
  1. Authentication (JWT token)
  2. Admin role (not staff)
  
  Only admin can manage staff.
end note

@enduml

